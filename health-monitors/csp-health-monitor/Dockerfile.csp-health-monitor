# csp-health-monitor image for the internal Lambda registry
# (lambdapublic.jfrog.io/lambda-mk8s-images/csp-health-monitor).
# The upstream image is built via ko (.ko.yaml); this Dockerfile exists so the
# Lambda shared build-and-push workflow, which is Dockerfile-based, can produce
# the equivalent single-binary image without requiring ko in the pipeline.

FROM golang:1.26 AS builder

WORKDIR /workspace

COPY health-monitors/csp-health-monitor/go.mod health-monitors/csp-health-monitor/go.sum ./health-monitors/csp-health-monitor/
COPY store-client/go.mod store-client/go.sum ./store-client/
COPY commons/go.mod commons/go.sum ./commons/
COPY data-models/go.mod data-models/go.sum ./data-models/
COPY api/go.mod api/go.sum ./api/

RUN cd health-monitors/csp-health-monitor && go mod download

COPY health-monitors/csp-health-monitor/ ./health-monitors/csp-health-monitor/
COPY store-client/ ./store-client/
COPY commons/ ./commons/
COPY data-models/ ./data-models/
COPY api/ ./api/

ARG VERSION=dev
ARG GIT_COMMIT=none
ARG BUILD_DATE=unknown

RUN cd health-monitors/csp-health-monitor && \
    CGO_ENABLED=0 GOOS=linux go build \
      -ldflags="-s -w -X main.version=${VERSION} -X main.commit=${GIT_COMMIT} -X main.date=${BUILD_DATE}" \
      -o /out/csp-health-monitor ./cmd/csp-health-monitor

FROM gcr.io/distroless/static:nonroot

COPY --from=builder /out/csp-health-monitor /csp-health-monitor

ENTRYPOINT ["/csp-health-monitor"]
